          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/users"
          },
          "response": []
        },
        {
          "name": "GET /api/causes — the causes catalogue",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns the seeded causes\", function () {",
                  "    const causes = pm.response.json();",
                  "    pm.expect(causes).to.be.an(\"array\").that.is.not.empty;",
                  "    const names = causes.map(function (c) { return c.cause_name; });",
                  "    pm.expect(names).to.include(\"Save the Turtles!\");",
                  "});",
                  "pm.test(\"First cause id saved for Workflow 1\", function () {",
                  "    const causes = pm.response.json();",
                  "    pm.collectionVariables.set(\"cause_id\", causes[0].id);",
                  "    pm.expect(pm.collectionVariables.get(\"cause_id\")).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/causes"
          },
          "response": []
        },
        {
          "name": "GET /api/rewards — affordability for bob",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Every card carries its affordability\", function () {",
                  "    const rewards = pm.response.json();",
                  "    pm.expect(rewards).to.be.an(\"array\").that.is.not.empty;",
                  "    rewards.forEach(function (r) {",
                  "        pm.expect(r).to.have.property(\"affordable\");",
                  "        pm.expect(r).to.have.property(\"hours_needed\");",
                  "    });",
                  "    const costs = rewards.map(function (r) { return r.hour_cost; });",
                  "    pm.expect(costs).to.deep.equal(costs.slice().sort(function (a, b) { return a - b; }));",
                  "});",
                  "pm.test(\"Cheapest affordable reward saved for Workflow 3\", function () {",
                  "    const rewards = pm.response.json();",
                  "    const gift = rewards.find(function (r) {",
                  "        return r.affordable && r.reward_name !== \"Charity Conversion\";",
                  "    });",
                  "    pm.expect(gift, \"an affordable reward\").to.not.be.undefined;",
                  "    pm.collectionVariables.set(\"reward_id\", gift.id);",
                  "    const charity = rewards.find(function (r) {",
                  "        return r.reward_name === \"Charity Conversion\";",
                  "    });",
                  "    if (charity) { pm.collectionVariables.set(\"charity_reward_id\", charity.id); }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/rewards"
          },
          "response": []
        },
