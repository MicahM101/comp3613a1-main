                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Shows the confirmation screen\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.text()).to.include(\"Are you sure you want to submit?\");",
                  "});",
                  "pm.test(\"Stored document path captured for the confirm step\", function () {",
                  "    const html = pm.response.text();",
                  "    const marker = 'name=\"document_path\" value=\"';",
                  "    const start = html.indexOf(marker);",
                  "    pm.expect(start, \"document_path hidden field\").to.be.above(-1);",
                  "    const from = start + marker.length;",
                  "    const path = html.slice(from, html.indexOf('\"', from));",
                  "    pm.collectionVariables.set(\"document_path\", path);",
                  "    pm.expect(path).to.include(\"/static/uploads/\");",
                  "});"
                ]
              }
            }
          ],
